option(USE_MKL "Try to use Intel MKL" ON)
option(USE_ACCELERATE "Try to use Apple Accelerate" ON)

function(link_solver_libraries target_name)
    if(WIN32 OR UNIX)
        if(USE_MKL)
            if(WIN32)
                set(MKL_THREADING "intel_thread")
            else()
                set(MKL_THREADING "gnu_thread")
            endif()
            set(MKL_INTERFACE lp64)
            set(MKL_SYCL_INTERFACE_FULL intel_lp64)
            find_package(MKL CONFIG QUIET)
            if (MKL_FOUND)
                target_link_libraries(${target_name} PUBLIC MKL::MKL)
                target_compile_definitions(${target_name} PUBLIC HAS_MKL)
                message(STATUS "${target_name}: enabled Intel MKL")
            endif()
        endif()
    endif()
    if(APPLE)
        if(USE_ACCELERATE AND Eigen3_VERSION VERSION_GREATER_EQUAL "5.0.0")
            target_link_libraries(${target_name} PUBLIC "-framework Accelerate")
            target_compile_definitions(${target_name} PUBLIC HAS_ACCELERATE)
            message(STATUS "${target_name}: enabled Apple Accelerate")
        endif()
    endif()
endfunction()